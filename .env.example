# 病理补充报告生成系统 —— 环境变量样例
#
# 复制为 .env 后按院内实际填写；.env 已被 .gitignore 排除，不会进入仓库。
# 所有凭据只从环境变量读取，代码里没有任何真实地址、端口或密钥。

# ---- 病理信息系统出站 ----
# 病理系统根地址（不带末尾斜杠），例：https://pathology.internal.example
PATHOLOGY_BASE_URL=
# 出站 Bearer 令牌，由信息科在病理系统侧签发
PATHOLOGY_API_TOKEN=

# ---- 入站 ----
# 结果回报投递目录：免疫组化室 / 分子实验室把 ORU^R01、ORM^O01 落盘到这里
PATHOLOGY_RESULT_INBOX=
# 状态库路径（挂起项、草稿版本链、回写队列、审计流水、幂等键）
PATHOLOGY_STATE_DB=data/patho_state.db

# ---- 部位同义词典（可选）----
# 外置部位别名词表（JSON：一行一条规范词 + 别名列表 + 可选科室限定）。
# 留空则使用内置最小词表；文件缺失或格式非法时自动回退内置词表并告警，不中断运行。
PATHOLOGY_LEXICON_PATH=dictionaries/region-lexicon.json

# ---- 通知（SMTP 为必选通道，企业微信可选）----
# SMTP 发信主机与端口（端口留空则不启用 SMTP 通道）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# 发件人显示地址
SMTP_FROM=
# 传输方式：SMTP_USE_SSL=true 走隐式 TLS（465 端口）；SMTP_STARTTLS=true 连上后
# 升级为加密连接（587 端口）。两个开关只能开一个，都关则走明文。
SMTP_USE_SSL=false
SMTP_STARTTLS=true
# SMTP 会话里报的机器名（EHLO/HELO）。留空用 localhost；
# 写死一个名字是为了发信时不等本机域名反查（院内机 DNS 常配不全）。
SMTP_HELO_NAME=localhost
# 默认收件人（逗号分隔，可多个）；排班表命中时按排班走，这里是兜底。
# 留空则 SMTP 通道不可用，通知会在运行摘要里显式标注降级。
NOTIFY_RECIPIENTS=
# 当班排班表（外置 JSON，科室自己维护）：命中当前时段就只通知当班医师。
# 留空 / 文件缺失 / 已过期 / 当前时段没排班 → 降级到上面的 NOTIFY_RECIPIENTS，
# 并在每轮运行摘要里显式写明降级。样例见 dictionaries/duty-roster.example.json。
NOTIFY_DUTY_ROSTER_PATH=
# 科室名（排班表若声明了别的科室，装载时会留告警）
NOTIFY_DUTY_DEPARTMENT=病理科
# 企业微信群机器人 webhook（可选；未配置时自动降级为只走 SMTP）
WECOM_WEBHOOK_URL=
# 通知通道重试次数（首发 + 重试）与重试间隔基数（秒）
NOTIFY_MAX_ATTEMPTS=2
NOTIFY_RETRY_DELAY_SECONDS=1
# 通知通道超时秒数
NOTIFY_TIMEOUT=10

# ---- 对齐判定阈值（可选，缺省用内置默认值）----
# 词法匹配命中阈值：部位描述词法得分达到该值才可进入「近似命中」
BM25_THRESHOLD=0.32
# 领先幅度阈值：最高分需领先次高分该幅度，否则判为歧义并挂起
LEAD_MARGIN_THRESHOLD=0.05
# 硬过滤策略：REPLACE（硬过滤完全覆盖）/ MERGE（硬过滤命中 0 条时降级为模糊匹配并标挂起）
FILTER_POLICY=MERGE
# 多路召回并发数
FANOUT_MAX_WORKERS=4
# 单路召回超时秒数
FANOUT_ROUTE_TIMEOUT=5
# 挂起尝试次数上限：同一条结果反复对不上时，超过该次数转人工处置，不再自动续跑
PENDING_MAX_ATTEMPTS=3

# ---- 运行参数（可选）----
# 目录监听轮询间隔秒数
WATCH_POLL_INTERVAL=2
# 目录监听稳定性检查等待秒数（等文件写完再读）
WATCH_SETTLE_SECONDS=0.5
# 定时兜底扫描间隔秒数：结果目录长时间没新文件时按这个周期强制扫一遍，
# 接住守护进程停机期间投进来的文件
WATCH_FALLBACK_INTERVAL=60
# 单实例锁文件路径（留空则放在状态库同级：<状态库目录>/patho_supplement.lock）。
# 同一个结果目录只允许一个守护进程在跑；两个实例盯不同目录时各给一把锁。
PATHOLOGY_LOCK_FILE=
# 回写失败重试上限（指数退避）
WRITEBACK_MAX_RETRIES=5
# 回写重试的退避基数秒数：第 1 次写回失败后等这么久再试
WRITEBACK_RETRY_BASE_SECONDS=5
# 回写重试的退避封顶秒数（再往上等也没意义）
WRITEBACK_RETRY_MAX_SECONDS=900
# 出站 HTTP 超时秒数
HTTP_TIMEOUT=10

# ---- 结构化行日志（可选）----
# 行日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）。
# 每轮一行摘要：处理条数 / 对齐条数 / 挂起条数 / 写回成功 / 写回失败 / 耗时。
LOG_LEVEL=INFO
# 行日志落盘文件（留空则写标准错误；业务输出始终留在标准输出）
LOG_FILE=
# 是否把**判读结果**（阳性 / 阴性 / 比例）原样写进日志。默认否 ——
# 日志常要发给信息科看，结果值不进日志；确实要查时才临时打开。
LOG_RESULT_VALUES=false

# ---- 规模与性能验收阈值（可选，缺省用内置默认值）----
# 跑规模集时端到端耗时的上限（秒）。超过即判定不合格。
SCALE_MAX_ELAPSED_SECONDS=60
# 单轮对齐率下限：并入草稿的条目占生效结果数的比例不得低于该值。
SCALE_MIN_ALIGNMENT_RATE=0.60
# 挂起率上限（与对齐率互补，分母同为生效结果数）。
SCALE_MAX_PENDING_RATE=0.40
# 峰值内存增量上限（MB）：状态只落 SQLite，中间对象一轮结束就释放。
SCALE_MAX_PEAK_MEMORY_MB=256
# 状态库体积上限（MB）：主库 + WAL + SHM 合计。
SCALE_MAX_STATE_DB_MB=64
